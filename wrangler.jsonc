{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alterity-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve prerendered /pricing from dist/pricing/index.html without a trailing slash.
    "html_handling": "drop-trailing-slash",
    // Unknown paths serve public/404.html with a real 404 status (fixes soft-404s).
    "not_found_handling": "404-page",
    // Run the worker first so the apex -> www redirect applies to every path.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.alterity.io", "custom_domain": true },
    { "pattern": "alterity.io", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
